{
  "name": "kartup-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:test": "bash scripts/db-test-local.sh",
    "functions:check": "cd supabase/functions && deno check */index.ts",
    "check": "npm run typecheck && npm test && npm run db:test",
    "brand:sync": "node scripts/brand-sync.ts",
    "web": "npm run brand:sync -- --skip-images && npm run web --workspace apps/mobile",
    "ios": "cd apps/mobile && npx expo run:ios",
    "iphone": "cd apps/mobile && npx expo run:ios --device --configuration Release",
    "start": "cd apps/mobile && npx expo start",
    "phone": "cd apps/mobile && npx expo start",
    "phone:tunnel": "cd apps/mobile && npx expo start --tunnel"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  }
}
