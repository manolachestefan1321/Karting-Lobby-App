{
  "name": "kartapp-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace apps/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:test": "bash scripts/db-test-local.sh",
    "functions:check": "cd supabase/functions && deno check */index.ts",
    "check": "npm run typecheck && npm test && npm run db:test"
  },
  "engines": {
    "node": ">=20"
  }
}
