# ─────────────────────────────────────────────────────────────────────────────
# Backend secrets (NEVER commit the real .env). Copy to .env in the repo root.
# Used by the local Supabase stack (supabase/config.toml reads these) and as a
# reference for `npx supabase secrets set` on the hosted project.
# The mobile app has its own file: apps/mobile/.env.example
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth (Google Cloud Console → Credentials). Client IDs comma-separated: web,ios,android
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Apple (your iOS bundle ID; add the Services ID too if you enable web sign-in)
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.kartup.app
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Facebook (developers.facebook.com → your app → Settings → Basic)
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=

# Stripe — added in step 4
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
