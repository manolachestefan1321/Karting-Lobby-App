{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      },
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_DATA_SOURCE": "supabase"
      },
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_DATA_SOURCE": "supabase"
      },
      "environment": "production"
    },
    "demo": {
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "demo",
        "EXPO_PUBLIC_DATA_SOURCE": "mock"
      },
      "environment": "preview"
    }
  },
  "submit": {
    "production": {
      "ios": {},
      "android": {
        "track": "internal"
      }
    },
    "demo": {
      "ios": {}
    }
  }
}
