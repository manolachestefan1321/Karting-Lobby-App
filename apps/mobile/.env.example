# Copy this file to .env in apps/mobile and fill in the values.
# EXPO_PUBLIC_* values are bundled into the app — never put secrets here.

# Which data the app uses is chosen by the command, not by this file:
#   npm run web / npm run phone:tunnel   → demo (fake drivers and sessions)
#   npm run web:real / npm run phone:real → real backend (needs the values below)
# Store builds (eas.json production/preview) always use the real backend.

# Supabase → Project Settings → API (the anon key is public by design; NEVER put the service_role key here)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Cloud Console → APIs & Services → Credentials (OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Expo → your project → Project ID (filled automatically by `eas init`)
EAS_PROJECT_ID=
